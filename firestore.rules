rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isStaffOrAdmin() {
      return isSignedIn() && (getUserData().role == 'ADMIN' || getUserData().role == 'STAFF');
    }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Test Connection Path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      // Must be owner or staff/admin to read
      // Note: List queries must be filtered by student_id == request.auth.uid if not admin/staff
      allow read: if isSignedIn() && (
        (exists(resource) && resource.data.student_id == request.auth.uid) || 
        isStaffOrAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (exists(resource) && resource.data.student_id == request.auth.uid) || 
        isStaffOrAdmin()
      );
      allow delete: if isStaffOrAdmin();
    }

    // Staff Directory Collection
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasRole('ADMIN');
    }

    // Campus Locations Collection
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasRole('ADMIN');
    }

    // Lost & Found Collection
    match /lost_found/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (exists(resource) && resource.data.reporterId == request.auth.uid) || 
        isStaffOrAdmin()
      );
      allow delete: if isStaffOrAdmin();
    }

    // Item Claims Collection
    match /claims/{claimId} {
      allow read: if isSignedIn() && (
        (exists(resource) && resource.data.claimantId == request.auth.uid) || 
        isStaffOrAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isStaffOrAdmin();
      allow delete: if hasRole('ADMIN');
    }
  }
}
