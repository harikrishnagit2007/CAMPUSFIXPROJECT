rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'harikrishna.gm.2025.aids@rajalakshmi.edu.in' ||
        request.auth.token.email == 'admin@campusfix.edu'
      );
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Campus Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Gemini Chatbot Multi-turn history
    match /chat_threads/{userId}/messages/{messageId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
