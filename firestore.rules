rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isStaffOrAdmin() {
      return isSignedIn(); 
    }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Test Connection Path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      // Must be owner or staff/admin to read
      allow read: if isSignedIn() && (resource.data.student_id == request.auth.uid || isStaffOrAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.student_id == request.auth.uid || isStaffOrAdmin());
    }

    // Staff Directory Collection
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    // Campus Locations Collection
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    // Lost & Found Collection
    match /lost_found/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isStaffOrAdmin());
    }

    // Item Claims Collection
    match /claims/{claimId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isStaffOrAdmin();
      allow delete: if false;
    }
  }
}
